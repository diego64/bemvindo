# API
PORTA=3000
NODE_ENV=development

# JWT
# Mínimo 32 caracteres. Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRETO=
JWT_EXPIRACAO_ACCESS=1h
JWT_EXPIRACAO_REFRESH=7d

# MongoDB 
# Credenciais do container MongoDB (usadas pelo docker-compose)
MONGO_USUARIO=
MONGO_SENHA=
# Local (Docker): mongodb://<usuario>:<senha>@bv-mongodb:27017/bem-vindo?authSource=admin
# Atlas:          mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/bem-vindo
MONGO_URI=

# Redis
# Credenciais do container Redis (usadas pelo docker-compose)
REDIS_USUARIO=
REDIS_SENHA=
# Local (Docker): redis://<usuario>:<senha>@bv-redis:6379
# Upstash:        rediss://<usuario>:<senha>@<host>.upstash.io:6379
REDIS_URL=

# Timezone
TZ=America/Sao_Paulo

# CORS
# Origens permitidas separadas por vírgula
# Exemplo: http://localhost:5173,https://app.empresa.com
CORS_ORIGENS=http://localhost:5173
