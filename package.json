{
  "name": "bemvindo",
  "version": "1.0.0",
  "description": "Sistema de recepção corporativa para controle de entrada de visitantes.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/infra/http/servidor.ts",
    "build": "tsc",
    "start": "node dist/infra/http/servidor.js",
    "prepare": "husky",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.11.0",
    "mongodb": "^7.2.0",
    "zod": "^4.4.3"
  }
}
